# Copy this file to .env.local to test on your own computer (that file is git-ignored and never uploaded),
# and add the same values in Vercel: Project, Settings, Environment Variables. Then redeploy once.
# Leave them empty and the project brief still works: it hands the brief over by WhatsApp or email instead.

# The Gmail account that sends the briefs (and receives them unless MAIL_TO is set)
GMAIL_USER=marabimadeit@gmail.com
# A Google "app password" (16 letters), not the account password. Never share or commit it.
GMAIL_APP_PASSWORD=
# Optional: send briefs somewhere else, e.g. several addresses separated by commas
MAIL_TO=
